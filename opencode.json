{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "techlead": {
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "webfetch": "deny",
        "skill": "deny",
        "task": {
          "*": "deny"
        },
        "bash": {
          "*": "allow"
        }
      }
    },
    "developer": {
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "webfetch": "allow",
        "skill": "allow",
        "bash": {
          "*": "allow"
        }
      }
    }
  }
}
